# ═══════════════════════════════════════════════════════════
#  Hikmah AI — Environment Variables Template
#  Nusxa oling: cp .env.example .env
#  Keyin qiymatlarni to'ldiring
# ═══════════════════════════════════════════════════════════

# ── Telegram ─────────────────────────────────────────────
BOT_TOKEN=8736641903:AAGKhvas-aB0tag3n8rELXjy7xmwJ-NIf00
BOT_USERNAME=aiHikmah_bot
ADMIN_IDS=7288872179,987654321

# ── AI Providers ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI provider: gemini | groq | openrouter
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-1.5-flash

# ── Firebase ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ── Database ─────────────────────────────────────────────
# SQLite (local dev)
DATABASE_URL=sqlite+aiosqlite:///./hikmah_ai.db

# PostgreSQL (production — uncomment and fill)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/hikmah_ai

# ── Redis (optional) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# ── Webhook (production) ─────────────────────────────────
WEBHOOK_HOST=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_random_webhook_secret_here

# ── FastAPI ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your_random_api_secret_here

# ── External APIs (Free) ─────────────────────────────────
# Weather (OpenWeatherMap — free tier)
WEATHER_API_KEY=your_openweathermap_api_key
# Currency (exchangerate-api.com — free tier)
CURRENCY_API_KEY=your_currency_api_key
# News (newsapi.org — free tier)
NEWS_API_KEY=your_newsapi_key

# ── Limits ────────────────────────────────────────────────
FREE_DAILY_LIMIT=50
PREMIUM_DAILY_LIMIT=300
PRO_DAILY_LIMIT=150

# ── Bot Settings ──────────────────────────────────────────
BOT_MODE=polling          # polling | webhook
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent

# ── Channels (Majburiy obuna) ─────────────────────────────
# Vergul bilan ajrating
REQUIRED_CHANNELS=-1001234567890,-1009876543210
SUBSCRIPTION_CHECK_ENABLED=true

# ── Referral ──────────────────────────────────────────────
REFERRAL_BONUS_REQUESTS=10

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW=60

# ── Islamic Features ─────────────────────────────────────
QURAN_API_URL=https://api.alquran.cloud/v1
PRAYER_TIME_API=https://api.aladhan.com/v1
